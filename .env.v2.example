# Required for docker-compose.v2.yml
LEADS_POSTGRES_PASSWORD=replace-me

# Production auth is fail-closed and should use Keycloak.
LEADS_AUTH_MODE=keycloak
LEADS_KEYCLOAK_ISSUER=https://keycloak.example/realms/codestra
LEADS_KEYCLOAK_AUDIENCE=leads-workstation
LEADS_KEYCLOAK_CLIENT_ID=leads-workstation
# Optional explicit JWKS URL. Defaults to issuer/protocol/openid-connect/certs.
LEADS_KEYCLOAK_JWKS_URL=

# Public bind remains loopback in compose by default.
LEADS_PORT=8765

# OpenBao webhook secret references use openbao://mount/path#field.
OPENBAO_ADDR=
OPENBAO_TOKEN=

# Optional internal Middleware service authentication for isolated staging only.
# Production user/agent authentication remains Keycloak.
# LEADS_AUTH_MODE=service
# LEADS_SERVICE_TOKEN=replace-with-secret-from-secret-store
# LEADS_SERVICE_ALLOWED_CIDRS=172.19.0.0/16,172.21.0.0/16
# LEADS_SERVICE_SUBJECT=middleware-staging
# LEADS_SERVICE_CAMPAIGNS=*
