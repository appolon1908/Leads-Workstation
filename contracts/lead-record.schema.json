{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codestra Lead Record",
  "type": "object",
  "required": [
    "lead_id",
    "business_name",
    "country",
    "business_category",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "lead_id": {
      "type": "string",
      "minLength": 1
    },
    "business_name": {
      "type": "string",
      "minLength": 1
    },
    "contact_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "state_province": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_category": {
      "type": "string",
      "minLength": 1
    },
    "campaign_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_contact_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "import_batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
